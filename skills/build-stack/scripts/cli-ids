#!/usr/bin/env python3
# Prints the `but` CLI IDs of the given uncommitted paths on one line, ready to pass to
# `but commit`/`but amend`. Fails naming every path that is not uncommitted.
import json
import subprocess
import sys

status = json.loads(
    subprocess.run(["but", "status", "--json"], capture_output=True, text=True, check=True).stdout
)
ids = {change["filePath"]: change["cliId"] for change in status["uncommittedChanges"]}
missing = [path for path in sys.argv[1:] if path not in ids]
if missing:
    sys.exit("not uncommitted: " + " ".join(missing))
print(" ".join(ids[path] for path in sys.argv[1:]))
