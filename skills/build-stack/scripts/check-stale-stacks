#!/usr/bin/env python3
# Lists GitButler stacks marked in the workspace whose head refs are gone from git:
# `but setup` accepts them, but every later `but unapply` fails on them.
import pathlib
import subprocess
import tomllib

git_dir = subprocess.run(
    ["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True, check=True
).stdout.strip()
state = pathlib.Path(git_dir) / "gitbutler" / "virtual_branches.toml"
if not state.exists():
    raise SystemExit(0)

for stack_id, stack in tomllib.loads(state.read_text()).get("branches", {}).items():
    if not stack.get("in_workspace"):
        continue
    for head in stack.get("heads", []):
        ref = f"refs/heads/{head['name']}"
        exists = subprocess.run(["git", "show-ref", "--verify", "--quiet", ref]).returncode == 0
        if not exists:
            print(f"{stack_id} {ref}")
